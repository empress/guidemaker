{
  "name": "guidemaker",
  "version": "4.0.6",
  "description": "Guidemaker Core Engine",
  "keywords": [
    "ember-addon",
    "guidemaker",
    "empress"
  ],
  "repository": "https://github.com/empress/guidemaker",
  "license": "MIT",
  "author": "",
  "exports": {
    ".": "./dist/index.js",
    "./vite": "./vite.mjs",
    "./addon-main.js": "./addon-main.cjs",
    "./package.json": "./package.json",
    "./_app_/*": "./dist/_app_/*",
    "./*": "./dist/*.js"
  },
  "files": [
    "addon-main.cjs",
    "blueprints",
    "dist",
    "vite.mjs"
  ],
  "scripts": {
    "build": "rollup --config",
    "lint": "concurrently \"pnpm:lint:*(!fix)\" --names \"lint:\"",
    "lint:css": "stylelint \"**/*.css\" --allow-empty-input",
    "lint:css:fix": "concurrently \"pnpm:lint:css -- --fix\"",
    "lint:fix": "concurrently \"pnpm:lint:*:fix\" --names \"fix:\"",
    "lint:js": "eslint . --cache",
    "lint:js:fix": "eslint . --fix",
    "prepack": "rollup --config",
    "start": "rollup --config --watch",
    "test": "pnpm test:node && pnpm test:ember",
    "test:ember": "pnpm build && pnpm install --prefer-offline && pnpm --filter test-app test",
    "test:node": "mocha node-tests"
  },
  "dependencies": {
    "@embroider/addon-shim": "^1.10.0",
    "compare-versions": "^3.5.0",
    "decorator-transforms": "^2.3.0",
    "ember-cli-showdown": "^10.0.0",
    "empress-blueprint-helpers": "^1.2.0",
    "html2plaintext": "^2.1.4",
    "js-yaml": "^3.13.1",
    "jsdom": "^24.1.3",
    "jsonapi-serializer": "^3.6.4",
    "lodash.truncate": "^4.4.2",
    "showdown-section-groups": "^0.3.0",
    "walk-sync": "^2.0.2",
    "yaml-front-matter": "^4.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.28.4",
    "@babel/eslint-parser": "^7.24.1",
    "@babel/plugin-proposal-decorators": "^7.24.1",
    "@embroider/addon-dev": "^8.3.0",
    "@rollup/plugin-babel": "^7.0.0",
    "babel-plugin-ember-template-compilation": "^4.0.0",
    "chai": "^4.2.0",
    "concurrently": "^8.2.2",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-ember": "^11.12.0",
    "eslint-plugin-n": "^16.6.2",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-qunit": "^8.1.1",
    "mocha": "^7.0.0",
    "prettier": "^3.2.5",
    "release-plan": "^0.17.0",
    "rollup": "^4.24.0",
    "showdown": "^2.1.0",
    "stylelint": "^15.11.0",
    "stylelint-config-standard": "^34.0.0",
    "stylelint-prettier": "^4.1.0"
  },
  "peerDependencies": {
    "@ember-data/adapter": "*",
    "@ember-data/model": "*",
    "@ember-data/serializer": "*",
    "@ember/test-helpers": "*",
    "ember-percy": "*",
    "showdown": "^2.0.0"
  },
  "peerDependenciesMeta": {
    "@ember/test-helpers": {
      "optional": true
    },
    "ember-percy": {
      "optional": true
    }
  },
  "packageManager": "pnpm@10.17.1+sha512.17c560fca4867ae9473a3899ad84a88334914f379be46d455cbf92e5cf4b39d34985d452d2583baf19967fa76cb5c17bc9e245529d0b98745721aa7200ecaf7a",
  "engines": {
    "node": ">= 20.19"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "ember": {
    "edition": "octane"
  },
  "ember-addon": {
    "version": 2,
    "type": "addon",
    "main": "addon-main.cjs",
    "after": [
      "ember-cli-head",
      "ember-data"
    ],
    "app-js": {
      "./adapters/application.js": "./dist/_app_/adapters/application.js",
      "./adapters/version.js": "./dist/_app_/adapters/version.js",
      "./components/head-content.js": "./dist/_app_/components/head-content.js",
      "./controllers/application.js": "./dist/_app_/controllers/application.js",
      "./controllers/version.js": "./dist/_app_/controllers/version.js",
      "./helpers/shorten-version.js": "./dist/_app_/helpers/shorten-version.js",
      "./initializers/register-showdown-extensions.js": "./dist/_app_/initializers/register-showdown-extensions.js",
      "./initializers/routes.js": "./dist/_app_/initializers/routes.js",
      "./instance-initializers/guidemaker-body-class.js": "./dist/_app_/instance-initializers/guidemaker-body-class.js",
      "./instance-initializers/guidemaker-head.js": "./dist/_app_/instance-initializers/guidemaker-head.js",
      "./instance-initializers/guidemaker-scroll.js": "./dist/_app_/instance-initializers/guidemaker-scroll.js",
      "./locations/trailing-history.js": "./dist/_app_/locations/trailing-history.js",
      "./models/content.js": "./dist/_app_/models/content.js",
      "./models/page.js": "./dist/_app_/models/page.js",
      "./models/version.js": "./dist/_app_/models/version.js",
      "./routes/application.js": "./dist/_app_/routes/application.js",
      "./routes/error.js": "./dist/_app_/routes/error.js",
      "./routes/index.js": "./dist/_app_/routes/index.js",
      "./routes/version.js": "./dist/_app_/routes/version.js",
      "./routes/version/index.js": "./dist/_app_/routes/version/index.js",
      "./routes/version/show.js": "./dist/_app_/routes/version/show.js",
      "./serializers/application.js": "./dist/_app_/serializers/application.js",
      "./services/guidemaker.js": "./dist/_app_/services/guidemaker.js",
      "./services/head-data.js": "./dist/_app_/services/head-data.js",
      "./services/page.js": "./dist/_app_/services/page.js"
    }
  },
  "fastbootDependencies": [
    "algoliasearch",
    "crypto"
  ]
}
